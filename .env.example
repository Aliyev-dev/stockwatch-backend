# --- Telegram ---
# Bot token from @BotFather. Server-side only, never exposed to clients.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your personal Telegram chat id (numeric). User support messages are forwarded here,
# and replies you send in that chat are relayed back to the user.
ADMIN_CHAT_ID=123456789

# --- Admin panel / admin API ---
# Long random string. Used as the admin password and API token.
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE key (not the anon key). Server-side only.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Server ---
PORT=8080

# Optional. Restricts CORS on POST /api/notify to this exact origin,
# e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Leave empty to allow any origin for POST /api/notify only.
ALLOWED_EXTENSION_ORIGIN=

# Optional. Public base URL of this service, shown in the admin panel / logs.
PUBLIC_URL=
